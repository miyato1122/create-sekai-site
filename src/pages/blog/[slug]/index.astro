---
import Base from '../../../layouts/Base.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE } from '../../../data/site';
import { getAllBlogs, type Blog } from '../../../lib/microcms';

export async function getStaticPaths() {
  const blogs = await getAllBlogs();
  return blogs.map((blog) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

interface Props {
  blog: Blog;
}

const { blog } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: blog.title,
  description: blog.description,
  datePublished: blog.publishedAt,
  ...(blog.revisedAt ? { dateModified: blog.revisedAt } : {}),
  ...(blog.eyecatch ? { image: [blog.eyecatch.url] } : {}),
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  mainEntityOfPage: new URL(`/blog/${blog.slug}/`, Astro.site).href,
};
---

<Base
  title={blog.title}
  description={blog.description}
  ogType="article"
  ogImage={blog.eyecatch?.url}
  jsonLd={jsonLd}
>
  <article>
    <header class="post-header">
      <h1>{blog.title}</h1>
      <p><FormattedDate date={blog.publishedAt} /></p>
      {
        blog.tags && blog.tags.length > 0 && (
          <ul class="tags">
            {blog.tags.map((tag) => (
              <li>
                <a href={`/blog/tags/${tag.slug}/`}>#{tag.name}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      blog.eyecatch && (
        <img
          class="eyecatch"
          src={blog.eyecatch.url}
          width={blog.eyecatch.width}
          height={blog.eyecatch.height}
          alt=""
        />
      )
    }
    <div class="prose" set:html={blog.content} />
  </article>
  <p class="back"><a href="/blog/">← 記事一覧へ</a></p>
</Base>

<style>
  .post-header {
    margin: 2.5rem 0 2rem;
  }

  .post-header h1 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
    line-height: 1.5;
  }

  .post-header p {
    margin: 0;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
  }

  .eyecatch {
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .back {
    margin-top: 3rem;
  }
</style>
