---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="ページが見つかりません">
  <section class="notfound">
    <h1>404</h1>
    <p>お探しのページは見つかりませんでした。</p>
    <p><a href={href('/')}>トップページへ戻る</a></p>
  </section>
</Base>

<style>
  .notfound {
    text-align: center;
    margin: 6rem 0;
  }

  .notfound h1 {
    font-size: 3rem;
    margin: 0 0 1rem;
  }
</style>
