---
import type { Blog } from '../lib/microcms';
import FormattedDate from './FormattedDate.astro';

interface Props {
  blog: Blog;
}

const { blog } = Astro.props;
---

<article class="blog-card">
  <FormattedDate date={blog.publishedAt} />
  <h3><a href={`/blog/${blog.slug}/`}>{blog.title}</a></h3>
  <p class="muted description">{blog.description}</p>
  {
    blog.tags && blog.tags.length > 0 && (
      <ul class="tags">
        {blog.tags.map((tag) => (
          <li>
            <a href={`/blog/tags/${tag.slug}/`}>#{tag.name}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .blog-card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  h3 {
    margin: 0.25rem 0;
    font-size: 1.1rem;
  }

  h3 a {
    color: var(--color-text);
  }

  h3 a:hover {
    color: var(--color-accent);
  }

  .description {
    margin: 0.25rem 0;
    font-size: 0.95rem;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.85rem;
  }
</style>
