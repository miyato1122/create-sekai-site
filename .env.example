# microCMS のサービスドメイン（https://xxxx.microcms.io の xxxx 部分）
MICROCMS_SERVICE_DOMAIN=

# microCMS の API キー（管理画面 > API キー）
MICROCMS_API_KEY=

# Cloudflare Web Analytics のビーコントークン
# （Cloudflare ダッシュボード > Analytics & Logs > Web Analytics > 手動セットアップ）
# 公開前提の値だが、未設定または本番ビルド以外ではビーコンを出力しない。
PUBLIC_CF_BEACON_TOKEN=
